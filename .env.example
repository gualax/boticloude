# ── Polymarket API (only needed for LIVE trading) ────────────────────
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_API_PASSPHRASE=your_passphrase_here
POLYMARKET_PRIVATE_KEY=your_wallet_private_key_here

# ── Bot configuration ────────────────────────────────────────────────
PAPER_TRADING=true
MAX_POSITION_SIZE=50
MAX_TOTAL_EXPOSURE=500
INITIAL_BALANCE=1000

# ── Polymarket endpoints ─────────────────────────────────────────────
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com

# ── Bitcoin / crypto pricing module ──────────────────────────────────
# Prices BTC/ETH/SOL threshold markets from real spot data + volatility.
# Uses public Binance/CoinGecko endpoints — no key required.
CRYPTO_ENABLED=true

# ── Gemini (brain for Hermes and the daily report) ───────────────────
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANALYSIS_HOUR=23

# ── Hermes learning agent ────────────────────────────────────────────
HERMES_ENABLED=true
HERMES_MODEL=gemini-3.1-pro-preview
HERMES_REFLECT_EVERY_N_TRADES=10

# ── Dashboard access ─────────────────────────────────────────────────
# Leave DASHBOARD_PASSWORD empty to run without a login (localhost only).
# Set it before exposing the port to any network.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Keeps sessions valid across restarts. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
